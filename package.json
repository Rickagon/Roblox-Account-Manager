{
  "name": "roblox-account-manager-v2",
  "version": "1.0.37",
  "description": "Modern Roblox account manager",
  "author": "RAM v2",
  "main": "main.js",
  "build": {
    "appId": "com.ic3.robloxaccountmanager.v2",
    "productName": "Roblox Account Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Roblox Account Manager"
    }
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "^0.7.15",
    "playwright-core": "^1.63.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
